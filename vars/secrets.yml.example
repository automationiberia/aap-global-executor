---
# Example secrets / local overrides for Global Executor playbooks.
# Copy to vars/secrets.yml and fill in real values, then encrypt:
#   cp vars/secrets.yml.example vars/secrets.yml
#   ansible-vault encrypt vars/secrets.yml --vault-password-file .vault_pass
#
# vars/secrets.yml is gitignored and must never be pushed.

# AAP / Gateway API connection (sync + bootstrap)
vault_aap_hostname: "https://aap.example.com"
vault_aap_username: "admin"
vault_aap_password: "CHANGE_ME"
vault_aap_validate_certs: false

# LDAP / Active Directory bind (local runs + bootstrap LDAP credential)
vault_ldap_server: "ldaps://dc.example.com:636"
vault_ldap_bind_dn: "CN=Administrator,CN=Users,DC=example,DC=com"
vault_ldap_bind_password: "CHANGE_ME"
vault_ldap_search_base: "CN=Users,DC=example,DC=com"
vault_ldap_validate_certs: false

# Optional bootstrap overrides (otherwise edit bootstrap_aap_runner.yml)
project_scm_url: "https://github.com/EXAMPLE_ORG/aap-global-executor.git"
project_scm_branch: "main"

ge_execution_environment: "CHANGE_ME_EE"
ge_vault_credential: "CHANGE_ME_VAULT_CREDENTIAL"
ge_aap_api_credential: "CHANGE_ME_AAP_API_CREDENTIAL"
