---
# Example secrets file for Global Executor playbooks.
# Copy to vars/secrets.yml and fill in real values, then encrypt:
#   cp vars/secrets.yml.example vars/secrets.yml
#   ansible-vault encrypt vars/secrets.yml --vault-password-file .vault_pass
#
# vars/secrets.yml is gitignored and must never be pushed.

# AAP / Gateway API connection (used by sync + bootstrap playbooks)
vault_aap_hostname: "https://aap.example.com"
vault_aap_username: "admin"
vault_aap_password: "CHANGE_ME"
vault_aap_validate_certs: false
